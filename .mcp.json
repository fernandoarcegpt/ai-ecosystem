{
  "mcpServers": {
    "memorwise": {
      "command": "node",
      "args": [
        "/home/fernando/ai-ecosystem/memorwise/mcp-server.js"
      ]
    },
    "claude-flow": {
      "command": "npx",
      "args": [
        "-y",
        "@latest",
        "mcp",
        "start"
      ],
      "env": {
        "npm_config_update_notifier": "false",
        "CLAUDE_FLOW_MODE": "v3",
        "CLAUDE_FLOW_HOOKS_ENABLED": "true",
        "CLAUDE_FLOW_TOPOLOGY": "hierarchical-mesh",
        "CLAUDE_FLOW_MAX_AGENTS": "15",
        "CLAUDE_FLOW_MEMORY_BACKEND": "hybrid"
      },
      "autoStart": false
    },
    "ruv-swarm": {
      "command": "npx",
      "args": [
        "-y",
        "ruv-swarm",
        "mcp",
        "start"
      ],
      "env": {
        "npm_config_update_notifier": "false"
      },
      "optional": true
    },
    "zlibrary-mcp": {
      "type": "stdio",
      "command": "node",
      "args": [
        "/home/fernando/ai-ecosystem/zlibrary-mcp/dist/index.js"
      ],
      "env": {
        "ZLIBRARY_EMAIL": "farse1@hotmail.com",
        "ZLIBRARY_PASSWORD": "Xlareputa"
      }
    },
    "codebase-memory-mcp": {
      "command": "codebase-memory-mcp",
      "args": [],
      "optional": true
    }
  }
}