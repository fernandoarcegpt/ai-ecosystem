*.swn

.vscode/
.idea/


# =========================================================
# OPERATING SYSTEM
# =========================================================

.DS_Store
Thumbs.db
desktop.ini


# =========================================================
# EXTERNAL / INDEPENDENT PROJECTS
# =========================================================
#
# These are third-party/independent repositories physically
# located inside ai-ecosystem.
#
# Their complete source trees are managed independently and
# should NOT be duplicated in the ai-ecosystem repository.
#
# ai-ecosystem keeps only its own adapters, integration
# scripts, configuration, documentation and references.
# =========================================================

codebase-memory-mcp/
hermes-workspace/
notex/
ollama/
zlibrary-mcp/
patches/**/diff.txt
