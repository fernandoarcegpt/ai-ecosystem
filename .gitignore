# =========================================================
# HERMES LOCAL INSTALLATION / RUNTIME
# =========================================================
#
# Installed Hermes application/runtime.
# Project-owned Hermes integrations remain elsewhere
# in ai-ecosystem and are versioned normally.
# =========================================================

.hermes/


# =========================================================
# HERMES PROJECT MEMORY
# =========================================================
#
# KEEP:
#   sharememory/hermes_memory/memory.json
#   sharememory/hermes_memory/okf_index.json
#   sharememory/hermes_memory/trades.json
#   sharememory/hermes_memory/payloads/
#
# Ignore only transaction/temporary/corrupt state.
# =========================================================

sharememory/hermes_memory/memory.lock
sharememory/hermes_memory/memory-*.tmp
sharememory/hermes_memory/memory.corrupt-*.json


# =========================================================
# CLAUDE CODE
# =========================================================
#
# KEEP project-owned configuration:
#   .claude/CLAUDE.md
#   .claude/settings.json
#   .claude/hooks/
#   .claude/skills/
#   .claude/rules/
#   .claude/agents/
#   .claude/commands/
#   .claude/plans/
#
# Ignore runtime/local/session state.
# =========================================================

.claude/settings.local.json

.claude/projects/
.claude/file-history/
.claude/cache/
.claude/backups/

.claude/daemon/
.claude/jobs/
.claude/paste-cache/
.claude/shell-snapshots/
.claude/tasks/
.claude/teams/
.claude/telemetry/

# Downloaded plugin repositories/caches
.claude/plugins/marketplaces/
.claude/plugins/cache/
.claude/plugins/known_marketplaces.json

# Runtime/session files
.claude/history.jsonl
.claude/daemon.lock
.claude/daemon.status.json
.claude/.last-*


# =========================================================
# CLAUDE USER / LOCAL STATE
# =========================================================

.claude.json
.claude.json_backup_*


# =========================================================
# MCP
# =========================================================
#
# Root .mcp.json is intentionally NOT ignored.
# Claude Code uses project-scoped .mcp.json for
# configuration intended to be shared with the project.
#
# Never put actual secrets in it; reference environment
# variables instead.
# =========================================================


# =========================================================
# CLAUDE FLOW / RUFLO
# =========================================================
#
# KEEP .claude-flow/ project configuration.
# Exclude runtime coordination/memory state.
# =========================================================

.claude-flow/update-state.json

.swarm/

ruv-swarm.db*
ruvector.db*


# =========================================================
# GENERATED DATABASE STATE
# =========================================================

# Kuzu runtime database
storage/kuzu/*.kuzu
storage/kuzu/*.kuzu.*
storage/kuzu/*.wal
storage/kuzu/*.lock

# SQLite sidecar/runtime files
*.db-shm
*.db-wal
*.sqlite-shm
*.sqlite-wal
*.sqlite3-shm
*.sqlite3-wal


# =========================================================
# OLLAMA LOCAL DATA
# =========================================================

.ollama/


# =========================================================
# DOWNLOADED NLP DATA
# =========================================================

nltk_data/


# =========================================================
# EXTERNAL KNOWLEDGE / DOCUMENT LIBRARY
# =========================================================
#
# Raw books, PDFs and extracted images are knowledge
# sources, not source code. Keep them locally/external.
#
# A future README or manifest can still be versioned.
# =========================================================

library/*
!library/README.md
!library/manifest.json
!library/manifest.yaml
!library/manifest.yml


# =========================================================
# BACKUPS
# =========================================================

*_backup_*
.backup-*

*.bak
*.backup
*.old


# =========================================================
# DOWNLOADS
# =========================================================

downloads/


# =========================================================
# CACHE / TEMPORARY DIRECTORIES
# =========================================================

.cache/
.caches/

.temp/
temp/
tmp/

.ipynb_checkpoints/


# =========================================================
# LOGS
# =========================================================

logs/
*.log


