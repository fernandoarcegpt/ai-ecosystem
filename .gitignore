# =========================================================
# PYTHON
# =========================================================

# Virtual environments
.venv/
venv/
*-venv/
env/
.envdir/

# Generated Python files
__pycache__/
*.py[cod]
*$py.class

# Packaging
*.egg-info/
.eggs/
pip-wheel-metadata/

# Testing / lint / typing caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.tox/
.nox/

# Coverage
.coverage
.coverage.*
htmlcov/


# =========================================================
# ENVIRONMENT VARIABLES / SECRETS
# =========================================================

.env
.env.*

# Safe templates remain versioned
!.env.example
!.env.sample
!.env.template
!.env.dist

